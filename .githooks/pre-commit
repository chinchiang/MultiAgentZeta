#!/bin/sh
# Validate the toolkit design docs before every commit.
# Enable once per clone:  git config core.hooksPath .githooks
PY=$(command -v python3 || command -v python)
if [ -z "$PY" ]; then
  echo "pre-commit: python not found; cannot run docs check" >&2
  exit 1
fi
"$PY" -I docs/toolkit/tools/build.py --check || {
  echo "pre-commit: docs check failed. Fix the error above, or run" >&2
  echo "  python -I docs/toolkit/tools/build.py" >&2
  echo "to regenerate stale outputs, then stage the changes again." >&2
  exit 1
}
