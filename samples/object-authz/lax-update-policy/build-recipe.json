{
  "recipe_version": "1",
  "sample": "object-authz/lax-update-policy",
  "source_build": {
    "source_digest": "sha256:8a2acba187fc696ff3ca563b61e64052eb71c9475d38b6cf54e1f957a8fa669f",
    "lockfiles": [],
    "tools": [
      "supabase-cli"
    ],
    "build_commands": [],
    "resources": {
      "memory_gb": 4
    },
    "download_policy": "service images only from the tags pinned by the supabase-cli version in the support matrix"
  },
  "deployment": {
    "environment_variables": [],
    "test_substitutes": []
  },
  "service_init": {
    "services": [
      "db",
      "auth",
      "rest",
      "kong"
    ],
    "migrations": [
      "20261031000001_schema.sql",
      "20261031000002_document_policies.sql"
    ],
    "extensions": [
      "pgcrypto"
    ]
  },
  "test_data": {
    "seed": "supabase/seed.sql",
    "tenants": [
      "Tenant A",
      "Tenant B"
    ],
    "accounts": [
      "alice@tenant-a.test",
      "bob@tenant-a.test",
      "carol@tenant-b.test"
    ],
    "roles": [
      "member"
    ],
    "sharing_exceptions": [
      {
        "marker": "MARK-A-ALICE-SHARED-TO-B",
        "readers": "members of Tenant B (document_shares)",
        "actions": [
          "read"
        ]
      }
    ],
    "related_resources": [
      "memberships",
      "document_shares"
    ],
    "markers": [
      "MARK-A-ALICE-PRIVATE",
      "MARK-A-ALICE-SHARED",
      "MARK-A-ALICE-SHARED-TO-B",
      "MARK-B-CAROL-PRIVATE"
    ],
    "synthetic_statement": {
      "method": "written by hand for this sample: invented tenants, accounts on the reserved .test domain and notes with no real content",
      "confirmed_by": "sample-maintainer",
      "confirmed_at": "2026-11-04T00:00:00Z"
    }
  },
  "auth": {
    "identities": [
      {
        "name": "anonymous"
      },
      {
        "name": "owner",
        "email": "alice@tenant-a.test",
        "login": "password"
      },
      {
        "name": "same_tenant_non_owner",
        "email": "bob@tenant-a.test",
        "login": "password"
      },
      {
        "name": "other_tenant_user",
        "email": "carol@tenant-b.test",
        "login": "password"
      }
    ],
    "token_transport": "bearer-header",
    "token_refresh": "refresh_token grant",
    "expiry_revocation_check": "a refresh token stops working after logout"
  },
  "health": {
    "services_up": [
      "rest",
      "auth"
    ],
    "legit_operations": [
      {
        "identity": "owner",
        "read": "documents",
        "marker": "MARK-A-ALICE-PRIVATE"
      }
    ]
  },
  "snapshot_reset": {
    "seed_version": "2026-11-04.1",
    "reset_scope": "database: migrations and seed are re-applied",
    "reset_check": "the documents table holds exactly the test_data markers",
    "cleanup": "containers and volumes removed"
  },
  "observer": {
    "select_on": [
      "public.documents"
    ]
  }
}
