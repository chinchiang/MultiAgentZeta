      "id": "S2-OWNER-ONLY",
      "statement": "資源預設僅擁有者可讀寫。",
      "rule": "deny",
      "actors": "same-tenant non-owner"
    },
    {
      "id": "S2-TENANT-ISOLATION",
      "statement": "租戶間預設完全隔離。",
      "rule": "deny",
      "actors": "user of another tenant"
    },
    {
      "id": "S2-ANON-NO-ACCESS",
      "statement": "未登入者預設不可讀寫。",
      "rule": "deny",
      "actors": "anonymous"
    }
  ],
