{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinchiang/MultiAgentZeta/toolkit/schemas/report-v1.json",
  "title": "Scan run report, version 1 (TK-EVD-003)",
  "type": "object",
  "allOf": [
    {"$ref": "#/$defs/common"},
    {
      "description": "TK-DAT-001: every report names the commit it tested, except one blocked at preflight (toolkit.scan only records null there when the ScanManifest named no commit).",
      "if": {
        "required": ["status", "stages"],
        "properties": {
          "status": {"const": "blocked"},
          "stages": {"contains": {"required": ["stage", "status"],
                                  "properties": {"stage": {"const": "preflight"}, "status": {"const": "blocked"}}}}
        }
      },
      "else": {"properties": {"commit": {"$ref": "#/$defs/text"}}}
    },
    {
      "description": "A completed run has a definite result (passed or failed) for every test.",
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {"properties": {"execution_records": {"items": {"properties": {"result": {"enum": ["passed", "failed"]}}}}}}
    }
  ],
  "required": ["status", "manifest", "stages", "requirements", "authorization_matrix", "execution_records", "findings",
               "coverage", "limits", "source_changes", "review_record", "review_summary", "toolkit_version",
               "evidence_package"],
  "unevaluatedProperties": false,
  "properties": {
    "limits": {
      "description": "〈定義：執行限制的執行〉 (TK-BUD-003): the run's limits on requests, time and concurrency as the ScanManifest states them, and what the run used. A stated limit is null when it was missing or no positive integer, which blocks the run in preflight. requests counts the actor requests and observer reads of the run's cases; elapsed_seconds is the time from the start of the run to its report; cases run one at a time.",
      "type": "object", "additionalProperties": false,
      "required": ["max_requests", "requests", "max_duration_seconds", "elapsed_seconds", "max_concurrency", "concurrency"],
      "properties": {
        "max_requests": {"type": ["integer", "null"], "minimum": 1},
        "requests": {"type": "integer", "minimum": 0},
        "max_duration_seconds": {"type": ["integer", "null"], "minimum": 1},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "max_concurrency": {"type": ["integer", "null"], "minimum": 1},
        "concurrency": {"const": 1}
      }
    },
    "manifest": {
      "description": "The ScanManifest the run was given: its identifier as given (any JSON value when the run was blocked for it, 〈定義：必要輸入〉) and the digest of its content.",
      "type": "object", "required": ["id", "digest"], "additionalProperties": false,
      "properties": {"id": {}, "digest": {"$ref": "#/$defs/text"}}
    },
    "authorization_matrix": {
      "description": "TK-IDN-003: the identities of the run and how each one's credentials travel, as confirmed in the BuildRecipe; empty when no environment was prepared.",
      "type": "array",
      "items": {"type": "object", "required": ["identity", "transport", "transport_source", "path"],
                "additionalProperties": false,
                "properties": {"identity": {"$ref": "#/$defs/text"}, "transport": {"$ref": "#/$defs/text"},
                               "transport_source": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}}}
    },
    "stages": {
      "description": "TK-RUN-001, 〈定義：工作階段〉: preflight 前置檢查, static_analysis 靜態與架構分析, model_review 模型審查, threat_planning 威脅與測試規劃, dynamic_execution 動態執行, judgement_report 判定與報告. validate() also requires every stage to be listed.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "status"],
        "properties": {
          "stage": {"enum": ["preflight", "static_analysis", "model_review", "threat_planning",
                             "dynamic_execution", "judgement_report"]},
          "status": {"enum": ["completed", "failed", "blocked", "cancelled", "not_run"]},
          "reason": {"$ref": "#/$defs/text"}
        },
        "if": {"properties": {"status": {"not": {"const": "completed"}}}},
        "then": {"required": ["reason"]}
      }
    },
    "requirements": {
      "description": "〈定義：確認清單〉: the confirmation items the planned tests rest on, with their review state. status is the item's 處理狀態, not a finding state.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "statement", "rule", "status", "out_of_scope", "confirmation"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "source": {"enum": ["S1", "S2"], "description": "Never the implementation (TK-REQ-005)."},
          "statement": {"$ref": "#/$defs/text"},
          "rule": {"enum": ["deny", "allow"]},
          "status": {"enum": ["pending", "accepted", "modified", "not_applicable"],
                     "description": "pending 待確認, accepted 接受, modified 修改, not_applicable 不適用."},
          "out_of_scope": {"type": "boolean"},
          "confirmation": {
            "type": "object",
            "required": ["by", "at", "version"],
            "additionalProperties": false,
            "properties": {"by": {"type": ["string", "null"]}, "at": {"type": ["string", "null"]},
                           "version": {"type": "integer", "minimum": 1},
                           "allowed_tests": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1,
                                             "description": "Given for a 合法例外 only: the tests on the item judged by allow; rule is the one of every other test (TK-DYN-003)."},
                           "expiry": {"type": "string", "description": "Expiry time of the 合法例外."}}
          }
        }
      }
    },
    "authorization": {
      "description": "〈定義：測試授權紀錄〉 the run was authorized by: its control-zone reference and content. The names in it are declared, not verified (identity_verified false, TK-HRV-004).",
      "type": "object",
      "required": ["path", "digest", "targets", "environment", "data_scope", "valid_from", "valid_until", "operations",
                   "roles", "issued_by", "issued_at", "extra_approvals", "identity_verified"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "environment": {"$ref": "#/$defs/text"},
        "data_scope": {"$ref": "#/$defs/text"},
        "valid_from": {"$ref": "#/$defs/text"},
        "valid_until": {"$ref": "#/$defs/text"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/authorized_operation"}},
        "roles": {"type": "object", "required": ["app_owner", "operator"], "additionalProperties": false,
                  "properties": {"app_owner": {"$ref": "#/$defs/text"}, "operator": {"$ref": "#/$defs/text"}}},
        "issued_by": {"$ref": "#/$defs/text"},
        "issued_at": {"$ref": "#/$defs/text"},
        "extra_approvals": {"type": "array", "items": {
          "type": "object", "required": ["approval_id", "operations", "by", "at", "reason", "valid_until"],
          "additionalProperties": false,
          "properties": {"approval_id": {"$ref": "#/$defs/text"},
                         "operations": {"type": "array", "items": {"$ref": "#/$defs/authorized_operation"}},
                         "by": {"$ref": "#/$defs/text"}, "at": {"$ref": "#/$defs/text"},
                         "reason": {"$ref": "#/$defs/text"}, "valid_until": {"$ref": "#/$defs/text"}}}},
        "identity_verified": {"const": false}
      }
    },
    "review_record": {
      "description": "〈定義：覆核紀錄〉: the review record this run used, in the control zone, by path and digest; null when the run used none (the ScanManifest referenced none, or the run stopped before reading it), so every finding is pending.",
      "anyOf": [
        {
          "type": "object",
          "required": ["path", "digest"],
          "additionalProperties": false,
          "properties": {"path": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/text"}}
        },
        {"type": "null"}
      ]
    },
    "review_summary": {
      "description": "〈定義：覆核紀錄〉 報告: how many findings are in each 覆核狀態; an unreviewed finding stays in the report (TK-HRV-010).",
      "type": "object",
      "required": ["pending", "overdue", "approved", "rejected", "evidence_pending"],
      "additionalProperties": false,
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "overdue": {"type": "integer", "minimum": 0},
        "approved": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "evidence_pending": {"type": "integer", "minimum": 0}
      }
    },
    "source_changes": {
      "description": "TK-ENV-006: changes made to the source under test for the run. v0.1 makes none: the source is the one source_digest pins.",
      "type": "array", "maxItems": 0
    },
    "environment": {
      "description": "〈定義：核心資料物件與相依紀錄〉 EnvironmentProfile summary for this run (TK-SCP-001, TK-ENV-007, TK-EVD-005): the environment mode, the digest of the full profile, any versions outside the support matrix, the known differences from E2 or production, and the isolation checked after the stack started (〈定義：E1 隔離〉, TK-SBX-004, TK-ENV-008).",
      "type": "object",
      "required": ["mode", "profile_digest", "unsupported", "known_differences", "isolation", "test_data", "seed_version", "service_images"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["E0", "E1", "E2"]},
        "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "unsupported": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "known_differences": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "seed_version": {"description": "TK-EVD-001: the version of the synthetic test data, from the BuildRecipe.", "type": "string"},
        "service_images": {
          "description": "TK-EVD-001: each service of the stack with the image it ran and that image's content digest (empty when Docker reports none).",
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["service", "image", "digest"],
                    "properties": {"service": {"$ref": "#/$defs/text"}, "image": {"type": "string"}, "digest": {"type": "string"}}}
        },
        "test_data": {
          "description": "TK-SBX-011, TK-SBX-012: the statement that the test data is synthetic (the confirmer's, never inferred by the tool) and the domain exceptions a person confirmed. A domain exception is approved by one person until second-person approval exists (TK-REQ-014).",
          "type": "object", "additionalProperties": false,
          "required": ["synthetic_statement", "domain_exceptions"],
          "properties": {
            "synthetic_statement": {
              "type": "object", "additionalProperties": false,
              "required": ["method", "confirmed_by", "confirmed_at"],
              "properties": {"method": {"$ref": "#/$defs/text"}, "confirmed_by": {"$ref": "#/$defs/text"},
                             "confirmed_at": {"$ref": "#/$defs/text"}}
            },
            "domain_exceptions": {
              "type": "array",
              "items": {"type": "object", "additionalProperties": false,
                        "required": ["account", "reason", "confirmed_by", "confirmed_at"],
                        "properties": {"account": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"},
                                       "confirmed_by": {"$ref": "#/$defs/text"}, "confirmed_at": {"$ref": "#/$defs/text"}}}
            }
          }
        },
        "isolation": {
          "description": "〈定義：E1 隔離〉: a run only gets an environment whose stack passed the checks, so outbound is always blocked here; limits says what the isolation does not cover (TK-EVD-014).",
          "type": "object",
          "required": ["outbound", "method", "host_access", "containers_checked", "limits"],
          "additionalProperties": false,
          "properties": {
            "outbound": {"const": "blocked"},
            "method": {"enum": ["internal-network"]},
            "host_access": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "containers_checked": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
            "limits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },
    "confirmation_list": {
      "description": "〈定義：確認清單〉: the list this run used or handed over, in the control zone. digest is the file as it is after the run: a list the run generated or updated (updated true) needs the owner's review and a new ScanManifest reference.",
      "type": "object",
      "required": ["path", "digest", "list_version", "updated", "s2_template", "summary", "out_of_scope", "single_approval"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "list_version": {"type": "integer", "minimum": 1},
        "updated": {"type": "boolean"},
        "s2_template": {
          "description": "The S2 template the list was produced from (TK-REQ-004, TK-REQ-008).",
          "type": "object",
          "required": ["policy_template_id", "version", "digest"],
          "additionalProperties": false,
          "properties": {
            "policy_template_id": {"$ref": "#/$defs/text"},
            "version": {"$ref": "#/$defs/text"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "summary": {
          "description": "TK-REQ-003: items in scope by source and 處理狀態 (pending 待確認, accepted 接受, modified 修改, not_applicable 不適用).",
          "type": "object",
          "required": ["S1", "S2"],
          "additionalProperties": false,
          "properties": {"S1": {"$ref": "#/$defs/review_counts"}, "S2": {"$ref": "#/$defs/review_counts"}}
        },
        "out_of_scope": {
          "description": "Items whose resources left the scope; not a review state, counted in no summary entry (〈定義：確認清單〉).",
          "type": "integer",
          "minimum": 0
        },
        "single_approval": {
          "description": "〈定義：確認清單〉 單人核准: modified and not applicable items in scope, approved by one person until a second approval exists (TK-REQ-014).",
          "type": "array",
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "status": {
      "description": "Overall run status (TK-RUN-002): pending 待執行, running 執行中, completed 完整完成, partial 部分完成, blocked 受阻, failed 失敗, cancelled 已取消. completed means every planned item got a definite result; it does not mean the application has no vulnerabilities.",
      "enum": ["pending", "running", "completed", "partial", "blocked", "failed", "cancelled"]
    },
    "status_reason": {"description": "Why the run is not completed.", "$ref": "#/$defs/text"},
    "self_validation": {
      "description": "〈定義：故障注入〉 (TK-VAL-001): present, and true, on a run of the toolkit's own acceptance. Only such a run has execution records with a fault.",
      "const": true
    },
    "toolkit_version": {"description": "TK-EVD-001: the version of the toolkit that made this report.", "$ref": "#/$defs/text"},
    "scope": {
      "description": "TK-EVD-005 範圍: the scope the ScanManifest states. Absent when the ScanManifest gave none that could be read.",
      "type": "object", "additionalProperties": false,
      "required": ["endpoints", "resources", "allowed_operations", "data_scope"],
      "properties": {"endpoints": {"type": "array", "items": {"$ref": "#/$defs/text"}},
                     "resources": {"type": "array", "items": {"$ref": "#/$defs/text"}},
                     "allowed_operations": {"type": "array", "items": {"$ref": "#/$defs/text"}},
                     "data_scope": {"$ref": "#/$defs/text"}}
    },
    "evidence_package": {
      "description": "〈定義：最低證據包的項目〉 (TK-EVD-001): every item of the minimum evidence package with whether this report holds it: present 具備, missing 缺件, not_applicable 不適用, each with where it is or why it is not. report.validate() recomputes it from the report.",
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["item", "status", "note"],
                "properties": {"item": {"$ref": "#/$defs/text"}, "status": {"enum": ["present", "missing", "not_applicable"]},
                               "note": {"$ref": "#/$defs/text"}}}
    },
    "environment_build": {
      "description": "〈定義：環境建置的量測〉 (TK-ENV-006): what the preparation of the environment and its resets attempted and completed, each part counted on its own and authentication per test identity. Present whenever the environment was asked for. A part with no attempt was not reached. These numbers are not part of any coverage or detection rate.",
      "type": "object", "additionalProperties": false,
      "required": ["build", "initialization", "test_data", "authentication", "health", "recovery"],
      "properties": {
        "build": {"$ref": "#/$defs/attempts"}, "initialization": {"$ref": "#/$defs/attempts"},
        "test_data": {"$ref": "#/$defs/attempts"}, "health": {"$ref": "#/$defs/attempts"},
        "recovery": {"$ref": "#/$defs/attempts"},
        "authentication": {"type": "object", "additionalProperties": {"$ref": "#/$defs/attempts"}}
      }
    },
    "cleanup": {
      "description": "〈定義：中止與清理〉 銷毀的查證 (TK-ENV-003, TK-SBX-010): whether the environment was found gone after it was destroyed, and what was still there when it was not. Present whenever an environment was prepared.",
      "type": "object", "additionalProperties": false,
      "required": ["environment", "leftovers"],
      "properties": {
        "environment": {"enum": ["destroyed", "destroy_failed"]},
        "leftovers": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "abort": {
      "description": "〈定義：中止與清理〉 (TK-RUN-004, TK-RUN-005, TK-RUN-006): who asked the run to stop, why and when; the steps in the order they were done, each with its time; the three measured times against the policy's limits; and what this version's abort does not cover (TK-EVD-014).",
      "type": "object", "additionalProperties": false,
      "required": ["source", "reason", "requested_at", "steps", "sessions", "in_flight", "seconds", "limits_seconds",
                   "over_limit", "not_covered"],
      "properties": {
        "source": {"enum": ["operator", "system"]},
        "reason": {"$ref": "#/$defs/text"},
        "requested_at": {"$ref": "#/$defs/text"},
        "steps": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["step", "at", "seconds"],
                    "properties": {"step": {"enum": ["dispatch_stopped", "credentials_revoked", "in_flight_ended",
                                                     "evidence_kept", "in_flight_checked", "environment_isolated"]},
                                   "at": {"$ref": "#/$defs/text"},
                                   "seconds": {"type": "number", "minimum": 0}}}
        },
        "sessions": {"type": "object", "additionalProperties": {"enum": ["revoked", "not_confirmed"]}},
        "in_flight": {"type": ["string", "null"]},
        "seconds": {"$ref": "#/$defs/abort_times"},
        "limits_seconds": {"$ref": "#/$defs/abort_times"},
        "over_limit": {"type": "array", "items": {"enum": ["dispatch_stopped", "in_flight_ended", "environment_isolated"]}},
        "not_covered": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "execution_records": {"type": "array", "items": {"$ref": "#/$defs/execution_record"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "attempts": {
      "description": "〈定義：環境建置的量測〉: how often a part was attempted and how often it completed.",
      "type": "object", "additionalProperties": false, "required": ["attempts", "successes"],
      "properties": {"attempts": {"type": "integer", "minimum": 0}, "successes": {"type": "integer", "minimum": 0}}
    },
    "abort_times": {
      "description": "TK-RUN-006: seconds from the abort request until dispatch stopped, the case in flight ended and the environment was isolated; null for a time that was not reached.",
      "type": "object", "additionalProperties": false,
      "required": ["dispatch_stopped", "in_flight_ended", "environment_isolated"],
      "properties": {"dispatch_stopped": {"type": ["number", "null"], "minimum": 0},
                     "in_flight_ended": {"type": ["number", "null"], "minimum": 0},
                     "environment_isolated": {"type": ["number", "null"], "minimum": 0}}
    },
    "common": {
      "description": "〈定義：共用欄位〉 plus the commit the record is bound to (TK-DAT-001).",
      "type": "object",
      "required": ["schema_version", "run_id", "id", "created_at", "source_id", "commit"],
      "properties": {
        "schema_version": {"const": "1"},
        "run_id": {"$ref": "#/$defs/text"},
        "id": {"$ref": "#/$defs/text"},
        "created_at": {"$ref": "#/$defs/text"},
        "source_id": {"$ref": "#/$defs/text"},
        "commit": {
          "description": "The source commit under test; null only in a report blocked at preflight (TK-DAT-001), which toolkit.scan writes when the ScanManifest named none (受測範圍, TK-SCP-002). report.validate() keeps every record on the report's commit.",
          "anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]
        }
      }
    },
    "authorized_operation": {
      "type": "object", "required": ["resource", "methods"], "additionalProperties": false,
      "properties": {"resource": {"$ref": "#/$defs/text"},
                     "methods": {"type": "array", "items": {"enum": ["GET", "POST", "PATCH", "DELETE"]}}}
    },
    "execution_record": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"description": "〈定義：故障注入〉: a case with an injected fault is undeterminable; it is never passed or failed.",
         "if": {"required": ["fault"]},
         "then": {"properties": {"result": {"not": {"enum": ["passed", "failed"]}}}}},
        {
          "description": "TK-DYN-001: a passed denial case carries all four checks.",
          "if": {"properties": {"result": {"const": "passed"}, "case_kind": {"not": {"const": "allowed"}}},
                 "required": ["result"]},
          "then": {
            "required": ["checks"],
            "properties": {"checks": {
              "required": ["resource_and_control", "identity", "no_disclosure_or_change", "response_and_side_effects"],
              "additionalProperties": {"const": true}
            }}
          }
        },
        {
          "description": "A passed allowed case (the requirement permits the access) shows the access was granted.",
          "if": {"properties": {"result": {"const": "passed"}, "case_kind": {"const": "allowed"}},
                 "required": ["result", "case_kind"]},
          "then": {"required": ["checks"], "properties": {"checks": {"required": ["access_granted"],
                                                                     "properties": {"access_granted": {"const": true}}}}}
        },
        {
          "description": "TK-IDN-009 and 〈定義：測試結果〉: a test that could not run is still recorded, as blocked or unsupported, with test_id, template_id, requirement_id, actor_ref and resource_ref as given in the ScanManifest, even when they are unusable. Any other result names its test with non-empty text.",
          "if": {"properties": {"result": {"enum": ["blocked", "unsupported"]}}, "required": ["result"]},
          "else": {"properties": {
            "test_id": {"$ref": "#/$defs/text"},
            "template_id": {"$ref": "#/$defs/text"},
            "requirement_id": {"$ref": "#/$defs/text"},
            "actor_ref": {"$ref": "#/$defs/text"},
            "resource_ref": {"$ref": "#/$defs/text"}
          }}
        }
      ],
      "required": ["result", "evidence", "requirement_version"],
      "unevaluatedProperties": false,
      "properties": {
        "test_id": {},
        "template_id": {},
        "requirement_id": {},
        "requirement_version": {
          "description": "TK-REQ-004: the version of the confirmation item the test rested on in this run; a later version of the item leaves this record as it is. null when the test names no item of the confirmation list.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "actor_ref": {},
        "resource_ref": {},
        "started_at": {"$ref": "#/$defs/text"},
        "ended_at": {"$ref": "#/$defs/text"},
        "error": {
          "description": "Why the case did not run normally, e.g. an observation failure (TK-IDN-009) or a timeout (執行錯誤, 〈定義：測試結果〉); null when it did.",
          "type": ["string", "null"]
        },
        "checks": {
          "description": "TK-DYN-001: resource exists and the control operation succeeds; the identity is valid and used; no disclosure and no unwanted state change; response and side effects meet the requirement.",
          "type": "object",
          "properties": {
            "resource_and_control": {"type": "boolean"},
            "identity": {"type": "boolean"},
            "no_disclosure_or_change": {"type": "boolean"},
            "response_and_side_effects": {"type": "boolean"},
            "access_granted": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "case_kind": {
          "description": "denial: the requirement forbids the access (TK-DYN-001 checks apply); allowed: the requirement permits it. Absent means denial.",
          "enum": ["denial", "allowed"]
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "approval_id": {
          "description": "〈定義：測試授權紀錄〉: the extra approval that let the test past the authorization; it is one of authorization.extra_approvals (TK-ENV-001).",
          "$ref": "#/$defs/text"
        },
        "fault": {
          "description": "〈定義：故障注入〉 (TK-VAL-001): the fault a self-validation run injected to make the case undeterminable. Such a record is blocked or an execution error, never a verdict (see the allOf of execution_record).",
          "enum": ["session-revoked", "observer-unavailable", "observer-timeout", "api-unreachable", "api-key-missing"]
        },
        "result": {
          "description": "〈定義：測試結果〉: passed 通過, failed 未通過, blocked 受阻, error 執行錯誤, untested 未測試, unsupported 不支援; cancelled 取消 is a scheduled case that was cancelled, counted apart from untested (〈定義：覆蓋面向〉 取消與未執行).",
          "enum": ["passed", "failed", "blocked", "error", "untested", "cancelled", "unsupported"]
        }
      }
    },
    "evidence": {
      "description": "One piece of evidence and the channel it was obtained through (TK-IDN-008): actor = a request made as an actor identity through the application's real path; observer = state read by the read-only observer role.",
      "type": "object",
      "required": ["id", "channel", "identity_ref", "digest", "type", "captured_at", "source", "access_level"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "digest": {"description": "TK-DAT-009: content digest of this evidence without its id and digest. It helps to notice changed bytes; it does not prove where the evidence came from.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "type": {"description": "TK-DAT-009: request_response 請求與回應, observation 觀測.", "enum": ["request_response", "observation"]},
        "captured_at": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"},
        "access_level": {"description": "TK-DAT-009, TK-EVD-002: restricted 限制存取.", "enum": ["restricted"]},
        "channel": {"enum": ["actor", "observer"]},
        "identity_ref": {"$ref": "#/$defs/text"},
        "point": {
          "description": "TK-IDN-010: when the observation was made: before 執行前, after 執行後, after_background 背景工作完成後.",
          "enum": ["before", "after", "after_background"]
        },
        "injection": {
          "description": "〈定義：故障注入〉: this request was the injection of the case's fault; applied 已注入, failed 注入失敗.",
          "enum": ["applied", "failed"]
        },
        "api_key_format": {
          "description": "TK-DYN-004: the API key format of an actor request: anon-jwt (legacy anon JWT) or publishable (sb_publishable_).",
          "enum": ["anon-jwt", "publishable"]
        },
        "observation": {"$ref": "#/$defs/observation"},
        "request": {
          "description": "The actor request as sent through the application's real path (TK-IDN-008).",
          "type": "object",
          "required": ["method", "path"],
          "properties": {
            "method": {"enum": ["GET", "POST", "PATCH", "DELETE"]},
            "path": {"$ref": "#/$defs/text"},
            "prefer": {"$ref": "#/$defs/text"}
          },
          "additionalProperties": false
        },
        "response": {
          "description": "What the actor saw: the status code and, when the body was a list, its row count (null otherwise). Judged against the contract, not by status code alone (TK-DYN-002).",
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"type": "integer"},
            "rows": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {"description": "TK-IDN-010: an observation states when it was made.",
         "if": {"properties": {"channel": {"const": "observer"}}, "required": ["channel"]},
         "then": {"required": ["point"]}},
        {"description": "TK-DYN-004: an actor request states the API key format it used.",
         "if": {"properties": {"channel": {"const": "actor"}}, "required": ["channel"]},
         "then": {"required": ["api_key_format"]}}
      ]
    },
    "observation": {
      "description": "State read by an observation template (TK-IDN-006). table_rows and table_digest cover the whole table, so changes to rows other than the target show as side effects (TK-DYN-001 item 4).",
      "type": "object",
      "required": ["template", "resource_exists", "table_rows", "table_digest"],
      "properties": {
        "template": {"$ref": "#/$defs/text"},
        "resource_exists": {"type": "boolean"},
        "shared": {"type": "boolean"},
        "state_digest": {"$ref": "#/$defs/text"},
        "table_rows": {"type": "integer", "minimum": 0},
        "table_digest": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "review_counts": {
      "type": "object",
      "required": ["pending", "accepted", "modified", "not_applicable"],
      "additionalProperties": false,
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "modified": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "description": "〈定義：核心資料物件與相依紀錄〉 FindingRecord: one per fingerprint, fingerprint version and requirement version of a run (〈定義：覆核紀錄〉 項目), with every failed execution record it rests on.",
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["fingerprint", "fingerprint_version", "requirement_id", "requirement_version", "root_cause", "status",
                   "evidence_type", "execution_record_ids", "review"],
      "unevaluatedProperties": false,
      "properties": {
        "fingerprint": {"$ref": "#/$defs/text"},
        "fingerprint_version": {"$ref": "#/$defs/text"},
        "requirement_id": {"$ref": "#/$defs/text"},
        "root_cause": {"$ref": "#/$defs/text"},
        "status": {
          "description": "〈定義：問題狀態〉: confirmed 已確認, evidence_pending 證據待補, not_reproduced 本次未重現, excluded 已排除, fixed_pending_regression 已修復待回歸, regression_passed 回歸通過.",
          "enum": ["confirmed", "evidence_pending", "not_reproduced", "excluded", "fixed_pending_regression",
                   "regression_passed"]
        },
        "evidence_type": {"$ref": "#/$defs/text"},
        "execution_record_ids": {
          "description": "The execution records the finding rests on, in the order they ran; report.validate() requires each to be a record of this report.",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}
        },
        "requirement_version": {
          "description": "TK-REQ-004: the version of the confirmation item the finding was judged on.",
          "type": "integer",
          "minimum": 1
        },
        "review": {"$ref": "#/$defs/finding_review"}
      }
    },
    "finding_review": {
      "description": "〈定義：覆核紀錄〉: the finding's 覆核狀態 and current decision. The decider is the account the platform reported (TK-HRV-004); an overdue review leaves the finding's status as it is (TK-HRV-007).",
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["pending", "overdue", "approved", "rejected", "evidence_pending"]},
        "opened_at": {"$ref": "#/$defs/text"},
        "decision": {
          "type": "object",
          "required": ["option", "by", "at", "reason"],
          "additionalProperties": false,
          "properties": {
            "option": {"enum": ["approve", "reject", "evidence_pending"]},
            "by": {
              "type": "object",
              "required": ["id", "login"],
              "additionalProperties": false,
              "properties": {"id": {"type": "integer"}, "login": {"$ref": "#/$defs/text"}}
            },
            "at": {"$ref": "#/$defs/text"},
            "reason": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "coverage": {
      "description": "〈定義：覆蓋面向〉 and 〈定義：擷取結果〉: the denominator is the scheduled cases plus the unsupported scopes; nothing blocked, errored, cancelled or unsupported leaves it (TK-EVD-008, AG-07). A rate is null over a zero denominator and then its state says why (TK-EVD-009).",
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["inventory_source", "inventory", "denominator", "executed", "valid_judgements", "blocked", "errors",
                   "untested", "cancelled", "unsupported", "unsupported_items", "effective_judgement_rate",
                   "tool_support_rate", "required_test_completion_rate", "states", "claim", "tables_and_policies",
                   "excluded", "excluded_record_ids", "rejected_exclusions"],
      "unevaluatedProperties": false,
      "properties": {
        "inventory_source": {"$ref": "#/$defs/text"},
        "inventory": {
          "type": "object", "additionalProperties": false,
          "required": ["rule", "supported_version", "loaded", "completeness", "unresolved"],
          "properties": {
            "rule": {"$ref": "#/$defs/text"},
            "supported_version": {"$ref": "#/$defs/text"},
            "loaded": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "completeness": {"enum": ["complete", "unknown"]},
            "unresolved": {
              "description": "Content extraction could not resolve, or that was not read; never taken as absent (TK-ARC-004).",
              "type": "array",
              "items": {"type": "object", "additionalProperties": false, "required": ["file", "line", "reason"],
                        "properties": {"file": {"$ref": "#/$defs/text"}, "line": {"type": "integer", "minimum": 0},
                                       "reason": {"$ref": "#/$defs/text"}}}
            }
          }
        },
        "denominator": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0},
        "valid_judgements": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "untested": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "unsupported_items": {
          "description": "Scope without a verified test method; counted in unsupported and in the denominator, never dropped silently (TK-EVD-008, AG-07). needs_supplement marks what needs supplementary observation (TK-ARC-004).",
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["scope", "reason"],
                    "properties": {"scope": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"},
                                   "needs_supplement": {"type": "boolean"}}}
        },
        "effective_judgement_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "tool_support_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "required_test_completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "states": {
          "type": "object", "additionalProperties": false,
          "required": ["effective_judgement_rate", "tool_support_rate", "required_test_completion_rate"],
          "properties": {
            "effective_judgement_rate": {"enum": ["measured", "not_applicable", "insufficient_data"]},
            "tool_support_rate": {"enum": ["measured", "not_applicable", "insufficient_data"]},
            "required_test_completion_rate": {"enum": ["measured", "not_applicable", "insufficient_data"]}
          }
        },
        "claim": {"enum": ["whole_scope", "known_scope_only"]},
        "tables_and_policies": {
          "type": "object", "additionalProperties": false,
          "required": ["inventoried", "rls_enabled", "without_policy", "unresolved", "judged"],
          "properties": {
            "inventoried": {"type": "integer", "minimum": 0}, "rls_enabled": {"type": "integer", "minimum": 0},
            "without_policy": {"type": "integer", "minimum": 0}, "unresolved": {"type": "integer", "minimum": 0},
            "judged": {"type": "integer", "minimum": 0}
          }
        },
        "excluded": {
          "description": "Items left out of the denominator: an item, a reason, a confirmer and a version, all four (TK-EVD-009).",
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["ref", "reason", "confirmed_by", "version"],
                    "properties": {"ref": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"},
                                   "confirmed_by": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}}
        },
        "excluded_record_ids": {
          "description": "〈定義：覆蓋面向〉 排除項: the execution records left out of the denominator because every item they exercise is excluded. report.validate() counts the denominator and the completion rate with them (TK-EVD-009).",
          "type": "array", "items": {"$ref": "#/$defs/text"}
        },
        "rejected_exclusions": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["ref", "problem"],
                    "properties": {"ref": {"$ref": "#/$defs/text"}, "problem": {"$ref": "#/$defs/text"}}}
        }
      }
    }
  }
}
