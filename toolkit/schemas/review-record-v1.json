{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinchiang/MultiAgentZeta/toolkit/schemas/review-record-v1.json",
  "title": "Review record (〈定義：覆核紀錄〉)",
  "description": "Review decisions kept in the control zone (TK-HRV-003). Decisions and rejected attempts only grow; the decider is the account the platform reported for a predefined label (TK-HRV-004). toolkit.review publish and sync write it; a ScanManifest may reference it by path and digest.",
  "type": "object",
  "required": ["schema_version", "platform", "repo", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "platform": {"$ref": "#/$defs/text"},
    "repo": {"$ref": "#/$defs/text"},
    "synced_at": {"$ref": "#/$defs/text"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "account": {
      "description": "The platform account: its numeric id is what is matched; the login is only shown.",
      "type": "object",
      "required": ["id", "login"],
      "additionalProperties": false,
      "properties": {"id": {"type": "integer"}, "login": {"$ref": "#/$defs/text"}}
    },
    "attempt": {
      "type": "object",
      "required": ["event_id", "option", "by", "at"],
      "properties": {
        "event_id": {"type": "integer"},
        "option": {"enum": ["approve", "reject", "evidence_pending"]},
        "by": {"$ref": "#/$defs/account"},
        "at": {"$ref": "#/$defs/text"}
      }
    },
    "item": {
      "type": "object",
      "required": ["review_type", "fingerprint", "fingerprint_version", "issue", "opened_at", "versions",
                   "decisions", "rejected"],
      "additionalProperties": false,
      "properties": {
        "review_type": {"enum": ["candidate_finding"]},
        "fingerprint": {"$ref": "#/$defs/text"},
        "fingerprint_version": {"$ref": "#/$defs/text"},
        "issue": {"type": "integer"},
        "opened_at": {"$ref": "#/$defs/text"},
        "versions": {
          "type": "object",
          "required": ["requirement_id", "requirement_version", "commit", "run_id"],
          "additionalProperties": false,
          "properties": {
            "requirement_id": {"$ref": "#/$defs/text"},
            "requirement_version": {"type": "integer", "minimum": 1},
            "commit": {"$ref": "#/$defs/text"},
            "run_id": {"$ref": "#/$defs/text"}
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "allOf": [{"$ref": "#/$defs/attempt"}],
            "required": ["reason", "reason_comments"],
            "properties": {
              "reason": {"$ref": "#/$defs/text"},
              "reason_comments": {
                "type": "array", "minItems": 1,
                "items": {"type": "object", "required": ["id", "updated_at"]}
              }
            }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "allOf": [{"$ref": "#/$defs/attempt"}],
            "required": ["problem"],
            "properties": {"problem": {"enum": ["no_role", "no_reason"]}}
          }
        }
      }
    }
  }
}
